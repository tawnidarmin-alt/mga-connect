                            import React, { useState } from "react";
import axios from "axios";
import "./App.css";

export default function Booking({ onBookingAdded }) {
  const [formData, setFormData] =3D useState({
    name: "",
    email: "",
    contactNumber: "",
    flightNumber: "",
    flightDate: "",
    flightTime: "",
    arrivalDeparture: "Arrival",
    numberOfPassenger: 1,
    passengerCategory: "Regular",
    corporateBankName: "",
    serviceType: "",
    numberOfLuggage: 0,
    lounge: "",
    transport: "",
    hotel: "",
    payment: "",
    otherRequirement: ""
  });

  const handleChange =3D (e) =3D&gt; {
    const { name, value } =3D e.target;
    setFormData({ ...formData, [name]: value });
  };

  const handleIncrement =3D (field) =3D&gt; {
    setFormData({ ...formData, [field]: Number(formData[field]) + 1 });
  };

  const handleDecrement =3D (field) =3D&gt; {
    if (formData[field] &gt; 0) {
      setFormData({ ...formData, [field]: Number(formData[field]) - 1 });
    }
  };
    const handleSubmit =3D async (e) =3D&gt; {
  e.preventDefault();
