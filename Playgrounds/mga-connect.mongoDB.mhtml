=3D"whitespace-pre-wrap">import React, { useState, useEffect, forwardRef, u=
seImperativeHandle } from "react";
import axios from "axios";
import "./App.css";

const BookingSummary =3D forwardRef(({ isStaff }, ref) =3D&gt; {
  const [bookings, setBookings] =3D useState([]);

  // Fetch all bookings
  const fetchBookings =3D async () =3D&gt; {
    try {
      const res =3D await axios.get("https://mga-connect.onrender.com/bookings");
      setBookings(res.data);
    } catch (err) {
      console.error("Error fetching bookings:", err);
    }
  };

  useImperativeHandle(ref, () =3D&gt; ({
    fetchBookings,
  }));

  useEffect(() =3D&gt; {
    fetchBookings();
    const interval =3D setInterval(fetchBookings, 10000);
    return () =3D&gt; clearInterval(interval);
  }, []);

  // Handle Notify button
  const handleNotify =3D async (id) =3D&gt; {
    try {
      const response =3D await fetch(<code>https://mga-connect.onrender.com/bookings/n=
otify/${id}</code>, {
        method: "POST",
      });

      if (response.ok) {
        setBookings((prev) =3D&gt;
          prev.map((b) =3D&gt;
            b._id =3D=3D=3D id ? { ...b, status: "Notified" } : b
          )
        );

        alert("Client has been notified!");
      }
    } catch (err) {
      console.error("Notify error:", err);
    }
  };

  // Handle Action dropdown
  const handleActionChange =3D async (id, selectedAction) =3D&gt; {
    try {
      await axios.put(<code>https://mga-connect.onrender.com/bookings/${id}</code>, {
        action: selectedAction,
      });
      fetchBookings();
    } catch (err) {
      console.error("Error updating action:", err);
      alert("=E2=9D=8C Failed to update action.");
    }
  };

  return (
    &lt;div className=3D"summary-container"&gt;
      &lt;h2 className=3D"summary-title"&gt;Booking Summary (Full View)&lt;=
/h2&gt;

      &lt;div className=3D"table-wrapper"&gt;
        &lt;table className=3D"summary-table" style=3D{{ fontSize: "11px", =
borderCollapse: "collapse" }}&gt;

          &lt;thead&gt;
            &lt;tr&gt;
              &lt;th&gt;No&lt;/th&gt;
              &lt;th&gt;Booking ID&lt;/th&gt;
              &lt;th&gt;Name&lt;/th&gt;
              &lt;th&gt;Email&lt;/th&gt;
              &lt;th&gt;Contact&lt;/th&gt;
              &lt;th&gt;Arr/Dep&lt;/th&gt;
              &lt;th&gt;Corp/Bank&lt;/th&gt;
              &lt;th&gt;PAX&lt;/th&gt;
              &lt;th&gt;Category&lt;/th&gt;
              &lt;th&gt;Flt No&lt;/th&gt;
              &lt;th&gt;Date&lt;/th&gt;
              &lt;th&gt;Time&lt;/th&gt;
              &lt;th&gt;Luggage&lt;/th&gt;
              &lt;th&gt;Service&lt;/th&gt;
              &lt;th&gt;Lounge&lt;/th&gt;
              &lt;th&gt;Transport&lt;/th&gt;
              &lt;th&gt;Hotel&lt;/th&gt;
              &lt;th&gt;Payment&lt;/th&gt;
              &lt;th&gt;Other Req&lt;/th&gt;
              &lt;th&gt;Bill (BDT)&lt;/th&gt;
              &lt;th&gt;Service By&lt;/th&gt;
              &lt;th&gt;Status&lt;/th&gt;
              &lt;th&gt;Action&lt;/th&gt;
            &lt;/tr&gt;
          &lt;/thead&gt;

          &lt;tbody&gt;
            {bookings.length &gt; 0 ? (
              bookings.map((b, i) =3D&gt; (
                &lt;tr key=3D{b._id || i}&gt;
  &lt;td&gt;{i + 1}&lt;/td&gt;
  &lt;td&gt;{b.bookingCode || "=E2=80=94"}&lt;/td&gt;
  &lt;td&gt;{b.name}&lt;/td&gt;
  &lt;td&gt;{b.email}&lt;/td&gt;
  &lt;td&gt;{b.contactNumber}&lt;/td&gt;
  &lt;td&gt;{b.arrivalDeparture}&lt;/td&gt;
  &lt;td&gt;{b.corporateBankName}&lt;/td&gt;
  &lt;td&gt;{b.numberOfPassenger}&lt;/td&gt;
  &lt;td&gt;{b.passengerCategory}&lt;/td&gt;
  &lt;td&gt;{b.flightNumber}&lt;/td&gt;
  &lt;td&gt;{b.flightDate}&lt;/td&gt;
  &lt;td&gt;{b.flightTime}&lt;/td&gt;
  &lt;td&gt;{b.numberOfLuggage}&lt;/td&gt;
  &lt;td&gt;{b.serviceType}&lt;/td&gt;
  &lt;td&gt;{b.lounge}&lt;/td&gt;
  &lt;td&gt;{b.transport}&lt;/td&gt;
  &lt;td&gt;{b.hotel}&lt;/td&gt;
  &lt;td&gt;{b.payment}&lt;/td&gt;

  {/* OTHER REQUIREMENT */}
  &lt;td style=3D{{ maxWidth: "150px", whiteSpace: "normal", wordBreak: "br=
eak-word" }}&gt;
    {b.otherRequirement}
  &lt;/td&gt;

  {/* BILL AMOUNT (Editable) */}
&lt;td&gt;
  &lt;input
    type=3D"number"
    value=3D{b.billAmount || ""}
    onChange=3D{(e) =3D&gt;
      handleFieldChange(b._id, "billAmount", e.target.value)
    }
    style=3D{{ width: "95%", textAlign: "right" }}
  /&gt;
&lt;/td&gt;

  {/* SERVICE BY (Editable for staff) */}
&lt;td&gt;
  &lt;input
    type=3D"text"
    value=3D{b.serviceBy || ""}
    onChange=3D{(e) =3D&gt;
      handleFieldChange(b._id, "serviceBy", e.target.value)
    }
    style=3D{{ width: "95%" }}
  /&gt;
&lt;/td&gt;

  {/* STATUS COLUMN */}
  &lt;td
    style=3D{{
      color:
        b.status =3D=3D=3D "Cancelled"
          ? "red"
          : b.status =3D=3D=3D "Notified"
          ? "green"
          : "#000",
      fontWeight: b.status ? "600" : "400",
    }}
  &gt;
    {b.status || "=E2=80=94"}
  &lt;/td&gt;

  {/* ACTION COLUMN */}
  &lt;td className=3D"action-buttons"&gt;
    {isStaff ? (
      b.status =3D=3D=3D "Notified" ? (
        &lt;span style=3D{{ color: "green", fontWeight: "600" }}&gt;Notifie=
d&lt;/span&gt;
      ) : b.status =3D=3D=3D "Cancelled" ? (
        &lt;span style=3D{{ color: "red", fontWeight: "600" }}&gt;Cancelled=
&lt;/span&gt;
      ) : (
        &lt;button
          onClick=3D{() =3D&gt; handleNotify(b._id)}
          style=3D{{
            padding: "4px 8px",
            backgroundColor: "#007bff",
            color: "white",
            border: "none",
            borderRadius: "4px",
            cursor: "pointer",
          }}
        &gt;
          Notify Client
        &lt;/button&gt;
      )
    ) : (
      &lt;button className=3D"cancel-btn" disabled&gt;
        Cancel
      &lt;/button&gt;
    )}
  &lt;/td&gt;
&lt;/tr&gt;

              ))
            ) : (
              &lt;tr&gt;
                &lt;td colSpan=3D"23" style=3D{{ textAlign: "center" }}&gt;
                  No Records Found!
                &lt;/td&gt;
              &lt;/tr&gt;
            )}
          &lt;/tbody&gt;

        &lt;/table&gt;
      &lt;/div&gt;
    &lt;/div&gt;
  );
});

export default BookingSummary;</div></div></div></div></div><div class=3D"z=
