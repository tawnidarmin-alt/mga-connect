// =E2=9C=85 Invoice Summary by Corporate/Bank Name (with safe numeric conv=
ersion)
app.get("/invoices/summary", async (req, res) =3D&gt; {
  try {
    const rows =3D await Booking.aggregate([
      {
        // Ensure safe conversion even when fields are missing or empty
        $addFields: {
          safePax: {
            $convert: {
              input: {
                $cond: [
                  { $in: ["$numberOfPassenger", [null, "", " "]] },
                  0,
                  "$numberOfPassenger"
                ]
              },
              to: "int",
              onError: 0,
              onNull: 0
            }
          },
          safeBill: {
            $convert: {
              input: {
                $cond: [
                  { $in: ["$billAmount", [null, "", " "]] },
                  0,
                  "$billAmount"
                ]
              },
              to: "double",
              onError: 0,
              onNull: 0
            }
          }
        }
      },
      {
        $group: {
          _id: { $ifNull: ["$corporateBankName", "Other"] },
          pax: { $sum: "$safePax" },
          billAmount: { $sum: "$safeBill" },
          totalBookings: { $sum: 1 },
          serviceTypes: { $addToSet: "$serviceType" }
        }
      },
      {
        $project: {
          _id: 0,
          corporateBankName: "$_id",
          pax: 1,
          billAmount: 1,
          totalBookings: 1,
          serviceTypes: 1,
          groupType: {
            $switch: {
              branches: [
                {
                  case: { $regexMatch: { input: { $toLower: "$_id" }, regex=
: "bank" } },
                  then: "Bank"
                },
                {
                  case: {
                    $regexMatch: {
                      input: { $toLower: "$_id" },
                      regex: "talon|haque|sikdar|rahim|chevron|lanka|brac|t=
ravel|group|asia|akbar|ezzy|one|finance"
                    }
                  },
                  then: "Corporate"
                }
              ],
              default: "Other"
            }
          }
        }
      },
      { $sort: { corporateBankName: 1 } }
    ]);

    const withNo =3D rows.map((r, idx) =3D&gt; ({ no: idx + 1, ...r }));
    res.json(withNo);
  } catch (err) {
    console.error("Error fetching invoice summary:", err);
    res.status(500).json({ message: "Error fetching invoice summary" });
  }
});
// =E2=9C=85 Invoice Details for a Selected Corporate/Bank
app.get("/invoices/details", async (req, res) =3D&gt; {
  const { corporateBankName } =3D req.query;

  if (!corporateBankName)
    return res.status(400).json({ message: "corporateBankName query is requ=
ired" });

  try {
    const bookings =3D await Booking.find({ corporateBankName });

    if (!bookings.length)
      return res.status(404).json({ message: "No bookings found for this cl=
ient" });

    res.json(bookings);
  } catch (err) {
    console.error("Error fetching invoice details:", err);
    res.status(500).json({ message: "Error fetching invoice details" });
  }
});

