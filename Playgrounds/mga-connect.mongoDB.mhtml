export default function InvoiceSummary() {
    const navigate =3D useNavigate();
  const [invoices, setInvoices] =3D useState([]);
  const [selectedClient, setSelectedClient] =3D useState(null);
  const [clientDetails, setClientDetails] =3D useState([]);
  const [filter, setFilter] =3D useState("All"); // =E2=86=90 New filter st=
ate

  const fetchInvoices =3D async () =3D&gt; {
    try {
      const res =3D await axios.get("https://mga-connect.onrender.com/invoices/summary=
");
      setInvoices(res.data || []);
    } catch (err) {
      console.error("Error fetching invoice summary:", err);
      alert("Failed to load invoice summary.");
    }
  };

  const fetchClientDetails =3D async (name) =3D&gt; {
    try {
      const res =3D await axios.get(
        <code>https://mga-connect.onrender.com/invoices/details?corporateBankName=3D${=
encodeURIComponent(name)}</code>
      );
      setSelectedClient(name);
      setClientDetails(res.data || []);
    } catch (err) {
      console.error("Error fetching client details:", err);
      alert("Failed to load client invoice details.");
