<li data-start=3D"1521" data-end=3D"1544">
<p data-start=3D"1524" data-end=3D"1544">Send a new booking</p>
</li>
<li data-start=3D"1545" data-end=3D"1563">
<p data-start=3D"1548" data-end=3D"1563">Notify Client</p>
</li>
<li data-start=3D"1564" data-end=3D"1587">
<p data-start=3D"1567" data-end=3D"1587">Tap Cancel on iPhone</p>
</li>
</ol>
<p data-start=3D"1589" data-end=3D"1602">Then tell me:</p>
