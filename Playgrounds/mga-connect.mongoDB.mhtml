<h3 data-start=3D"513" data-end=3D"532">What this does:</h3>
<ul data-start=3D"533" data-end=3D"605">
<li data-start=3D"533" data-end=3D"557">
<p data-start=3D"535" data-end=3D"557">Shows <strong data-start=3D"541" dat=
a-end=3D"557">50 documents</strong></p>
</li>
<li data-start=3D"558" data-end=3D"605">
<p data-start=3D"560" data-end=3D"574">Displays only:</p>
<ul data-start=3D"577" data-end=3D"605">
<li data-start=3D"577" data-end=3D"592">
<p data-start=3D"579" data-end=3D"592"><code data-start=3D"579" data-end=3D=
"592">bookingCode</code></p>
</li>
<li data-start=3D"595" data-end=3D"605">
