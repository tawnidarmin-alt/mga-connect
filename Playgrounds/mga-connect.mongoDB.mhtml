import axios from "axios";
import { useNavigate } from "react-router-dom";

export default function InvoiceSummary() {
    const navigate =3D useNavigate();
  const [invoices, setInvoices] =3D useState([]);
  const [selectedClient, setSelectedClient] =3D useState(null);
  const [clientDetails, setClientDetails] =3D useState([]);
  const [filter, setFilter] =3D useState("All"); // =E2=86=90 New filter st=
ate

  const fetchInvoices =3D async () =3D&gt; {
    try {
      const res =3D await axios.get("https://mga-connect.onrender.com/invoices/summary=
");
      setInvoices(res.data || []);
    } catch (err) {
      console.error("Error fetching invoice summary:", err);
      alert("Failed to load invoice summary.");
    }
  };

  const fetchClientDetails =3D async (name) =3D&gt; {
    try {
      const res =3D await axios.get(
        <code>https://mga-connect.onrender.com/invoices/details?corporateBankName=3D${=
encodeURIComponent(name)}</code>
      );
      setSelectedClient(name);
      setClientDetails(res.data || []);
    } catch (err) {
      console.error("Error fetching client details:", err);
      alert("Failed to load client invoice details.");
    }
  };

  useEffect(() =3D&gt; {
    fetchInvoices();
  }, []);

  // Filter invoices according to button
  const filteredInvoices =3D
    filter =3D=3D=3D "All"
      ? invoices
      : invoices.filter((item) =3D&gt; item.groupType =3D=3D=3D filter);

  // month label
  const monthYearLabel =3D () =3D&gt; {
    const sample =3D
      clientDetails &amp;&amp; clientDetails.length &gt; 0 ? clientDetails[=
0].flightDate : null;
    if (sample &amp;&amp; /^\d{4}-\d{2}-\d{2}$/.test(sample)) {
      const [y, m] =3D sample.split("-").map(Number);
      const d =3D new Date(y, m - 1, 1);
      return d.toLocaleString("default", { month: "long", year: "numeric" }=
);
    }
    return new Date().toLocaleString("default", { month: "long", year: "num=
eric" });
  };

  const totalPax =3D clientDetails.reduce(
    (sum, b) =3D&gt; sum + Number(b.numberOfPassenger || 0),
    0
  );
  const totalBill =3D clientDetails.reduce(
    (sum, b) =3D&gt; sum + Number(b.billAmount || 0),
    0
  );
  const vat =3D +(totalBill * 0.15).toFixed(2);
  const grandTotal =3D +(totalBill + vat).toFixed(2);

  return (
    &lt;div className=3D"invoice-summary" style=3D{{ maxWidth: 1200, margin=
: "0 auto" }}&gt;
      &lt;h2 style=3D{{ textAlign: "center", marginBottom: 20 }}&gt;Invoice=
 Summary&lt;/h2&gt;

      {/* FILTER BUTTONS */}
      &lt;div style=3D{{ textAlign: "center", marginBottom: 20 }}&gt;
        {["All", "Bank", "Corporate", "Other"].map((type) =3D&gt; (
          &lt;button
            key=3D{type}
            onClick=3D{() =3D&gt; setFilter(type)}
            style=3D{{
              backgroundColor: filter =3D=3D=3D type ? "#00a2ff" : "#f0f0f0=
",
              color: filter =3D=3D=3D type ? "#fff" : "#333",
              border: "none",
              borderRadius: "5px",
              margin: "0 6px",
              padding: "6px 14px",
              cursor: "pointer",
              fontWeight: filter =3D=3D=3D type ? "600" : "400",
              transition: "all 0.2s ease-in-out",
            }}
          &gt;
            {type}
          &lt;/button&gt;
        ))}
      &lt;/div&gt;

      {/* SUMMARY TABLE */}
      &lt;table
        style=3D{{
          width: "100%",
          borderCollapse: "collapse",
          fontSize: "13px",
          marginBottom: "20px",
        }}
      &gt;
        &lt;thead&gt;
          &lt;tr style=3D{{ backgroundColor: "#f0f6ff" }}&gt;
            &lt;th style=3D{{ border: "1px solid #ccc", padding: "6px" }}&g=
t;No&lt;/th&gt;
            &lt;th style=3D{{ border: "1px solid #ccc", padding: "6px" }}&g=
t;
              Corporate / Bank Name
            &lt;/th&gt;
            &lt;th style=3D{{ border: "1px solid #ccc", padding: "6px" }}&g=
t;Pax No&lt;/th&gt;
            &lt;th style=3D{{ border: "1px solid #ccc", padding: "6px" }}&g=
t;Bill Amount&lt;/th&gt;
            &lt;th style=3D{{ border: "1px solid #ccc", padding: "6px" }}&g=
t;Total Bookings&lt;/th&gt;
            &lt;th style=3D{{ border: "1px solid #ccc", padding: "6px" }}&g=
t;Action&lt;/th&gt;
          &lt;/tr&gt;
        &lt;/thead&gt;
        &lt;tbody&gt;
          {filteredInvoices.map((item, i) =3D&gt; (
            &lt;tr key=3D{<code>${item.corporateBankName}-${i}</code>}&gt;
              &lt;td style=3D{{ border: "1px solid #ccc", padding: "6px" }}=
&gt;
                {item.no ?? i + 1}
              &lt;/td&gt;
              &lt;td style=3D{{ border: "1px solid #ccc", padding: "6px" }}=
&gt;
                {item.corporateBankName}
              &lt;/td&gt;
              &lt;td style=3D{{ border: "1px solid #ccc", padding: "6px" }}=
&gt;{item.pax}&lt;/td&gt;
              &lt;td style=3D{{ border: "1px solid #ccc", padding: "6px" }}=
&gt;
                {item.billAmount}
              &lt;/td&gt;
              &lt;td style=3D{{ border: "1px solid #ccc", padding: "6px" }}=
&gt;
                {item.totalBookings}
              &lt;/td&gt;
              &lt;td style=3D{{ border: "1px solid #ccc", padding: "6px" }}=
&gt;
                &lt;button
                  onClick=3D{() =3D&gt; navigate(<code>/invoice/${encodeURI=
Component(item.corporateBankName)}</code>)}
                  style=3D{{
                    backgroundColor: "#00a2ff",
                    color: "#fff",
                    border: "none",
                    borderRadius: "5px",
                    padding: "5px 10px",
                    cursor: "pointer",
                  }}
                &gt;
                  View Details
                &lt;/button&gt;
              &lt;/td&gt;
            &lt;/tr&gt;
          ))}
          {filteredInvoices.length =3D=3D=3D 0 &amp;&amp; (
            &lt;tr&gt;
              &lt;td colSpan=3D{6} style=3D{{ textAlign: "center", padding:=
 12 }}&gt;
                No data found for {filter}
              &lt;/td&gt;
            &lt;/tr&gt;
          )}
        &lt;/tbody&gt;
      &lt;/table&gt;

      {/* DETAILS PANEL */}
      {selectedClient &amp;&amp; (
        &lt;div
          style=3D{{
            position: "relative",
            border: "1px solid #cce0ff",
            borderRadius: 10,
            padding: 16,
            background: "#f9fcff",
          }}
        &gt;
          &lt;button
            onClick=3D{() =3D&gt; {
              setSelectedClient(null);
              setClientDetails([]);
            }}
            aria-label=3D"Close"
            title=3D"Close"
            style=3D{{
              position: "absolute",
              right: 8,
              top: 8,
              border: "none",
              background: "transparent",
              fontSize: 18,
              cursor: "pointer",
            }}
          &gt;
            =C3=97
          &lt;/button&gt;

          &lt;div style=3D{{ textAlign: "center" }}&gt;
            &lt;h3 style=3D{{ marginBottom: 4 }}&gt;{selectedClient}&lt;/h3=
&gt;
            &lt;p style=3D{{ marginTop: 0, color: "#555" }}&gt;
              Bill for the Month of {monthYearLabel()}
            &lt;/p&gt;
          &lt;/div&gt;

          &lt;table
            style=3D{{
              width: "100%",
              borderCollapse: "collapse",
              fontSize: "12px",
              marginTop: "10px",
              background: "#fff",
            }}
          &gt;
            &lt;thead&gt;
              &lt;tr style=3D{{ backgroundColor: "#f0f6ff" }}&gt;
                &lt;th style=3D{{ border: "1px solid #ccc", padding: "6px" =
}}&gt;Date&lt;/th&gt;
                &lt;th style=3D{{ border: "1px solid #ccc", padding: "6px" =
}}&gt;Arr/Dep&lt;/th&gt;
                &lt;th style=3D{{ border: "1px solid #ccc", padding: "6px" =
}}&gt;Flight No&lt;/th&gt;
                &lt;th style=3D{{ border: "1px solid #ccc", padding: "6px" =
}}&gt;Pax Name&lt;/th&gt;
                &lt;th style=3D{{ border: "1px solid #ccc", padding: "6px" =
}}&gt;Pax&lt;/th&gt;
                &lt;th style=3D{{ border: "1px solid #ccc", padding: "6px" =
}}&gt;
                  Service Charge
                &lt;/th&gt;
                &lt;th style=3D{{ border: "1px solid #ccc", padding: "6px" =
}}&gt;Card No&lt;/th&gt;
              &lt;/tr&gt;
            &lt;/thead&gt;
            &lt;tbody&gt;
              {clientDetails.map((b, i) =3D&gt; (
                &lt;tr key=3D{<code>detail-${i}</code>}&gt;
                  &lt;td style=3D{{ border: "1px solid #ccc", padding: "6px=
" }}&gt;
                    {b.flightDate}
                  &lt;/td&gt;
                  &lt;td style=3D{{ border: "1px solid #ccc", padding: "6px=
" }}&gt;
                    {b.arrivalDeparture}
                  &lt;/td&gt;
                  &lt;td style=3D{{ border: "1px solid #ccc", padding: "6px=
" }}&gt;
                    {b.flightNumber}
                  &lt;/td&gt;
                  &lt;td style=3D{{ border: "1px solid #ccc", padding: "6px=
" }}&gt;{b.name}&lt;/td&gt;
                  &lt;td style=3D{{ border: "1px solid #ccc", padding: "6px=
" }}&gt;
                    {b.numberOfPassenger}
                  &lt;/td&gt;
                  &lt;td style=3D{{ border: "1px solid #ccc", padding: "6px=
" }}&gt;
                    {b.billAmount}
                  &lt;/td&gt;
                  &lt;td style=3D{{ border: "1px solid #ccc", padding: "6px=
" }}&gt;
                    {b.cardNumber || ""}
                  &lt;/td&gt;
                &lt;/tr&gt;
              ))}
            &lt;/tbody&gt;
          &lt;/table&gt;

          &lt;div style=3D{{ textAlign: "right", marginTop: 10 }}&gt;
            &lt;p&gt;&lt;strong&gt;Total PAX:&lt;/strong&gt; {totalPax}&lt;=
/p&gt;
            &lt;p&gt;&lt;strong&gt;Total Bill:&lt;/strong&gt; {totalBill.to=
Fixed(2)} BDT&lt;/p&gt;
            &lt;p&gt;&lt;strong&gt;VAT (15%):&lt;/strong&gt; {vat.toFixed(2=
)} BDT&lt;/p&gt;
            &lt;p style=3D{{ fontSize: 16 }}&gt;
              &lt;strong&gt;Grand Total:&lt;/strong&gt; {grandTotal.toFixed=
(2)} BDT
            &lt;/p&gt;
          &lt;/div&gt;
        &lt;/div&gt;
      )}
    &lt;/div&gt;
  );
}


