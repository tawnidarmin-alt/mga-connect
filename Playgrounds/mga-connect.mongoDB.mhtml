//  INVOICE SUMMARY (Group by Corporate/Bank Name)
//  Excluding Cancelled Bookings
// ------------------------------------------------------
app.get("/invoices/summary", async (req, res) =3D&gt; {
  try {
    const rows =3D await Booking.aggregate([
      // 1=EF=B8=8F=E2=83=A3 EXCLUDE cancelled bookings (case-insensitive)
      {
  $match: {
    $or: [
      { status: { $exists: false } },
      { status: "" },
      { status: null },
      { status: { $not: /^cancelled$/i } }
    ]
  }
      },

      // 2=EF=B8=8F=E2=83=A3 Normalize and convert numbers
      {
        $addFields: {
          safePax: {
            $convert: {
              input: "$numberOfPassenger",
              to: "int",
              onError: 0,
              onNull: 0
            }
          },
          safeBill: {
            $convert: {
              input: "$billAmount",
              to: "double",
              onError: 0,
              onNull: 0
            }
          }
        }
      },

      // 3=EF=B8=8F=E2=83=A3 Group by corporate/bank name
      {
        $group: {
          _id: { $ifNull: ["$corporateBankName", "Other"] },
          pax: { $sum: "$safePax" },
          billAmount: { $sum: "$safeBill" },
          totalBookings: { $sum: 1 },
          serviceTypes: { $addToSet: "$serviceType" }
        }
      },

      // 4=EF=B8=8F=E2=83=A3 Compute group type &amp; clean fields
      {
        $project: {
          _id: 0,
          corporateBankName: "$_id",
          pax: 1,
          billAmount: 1,
          totalBookings: 1,
          serviceTypes: 1,
          groupType: {
            $switch: {
              branches: [
                {
                  case: {
                    $regexMatch: {
                      input: { $toLower: "$_id" },
                      regex: "bank"
                    }
                  },
                  then: "Bank"
                },
                {
                  case: {
                    $regexMatch: {
                      input: { $toLower: "$_id" },
                      regex: "talon|haque|sikdar|rahim|chevron|lanka|brac|t=
ravel|group|asia|akbar|ezzy|one|finance"
                    }
                  },
                  then: "Corporate"
                }
              ],
              default: "Other"
            }
          }
        }
      },

      // 5=EF=B8=8F=E2=83=A3 Sort results neatly
      { $sort: { corporateBankName: 1 } }
    ]);

    // Add serial numbering
    const withNo =3D rows.map((r, idx) =3D&gt; ({ no: idx + 1, ...r }));

    res.json(withNo);
  } catch (err) {
    console.error("=E2=9D=8C Error fetching invoice summary:", err);
    res.status(500).json({ message: "Error fetching invoice summary" });
  }
});</div></div></div></div></div><div class=3D"z-0 flex justify-end"><div c=
