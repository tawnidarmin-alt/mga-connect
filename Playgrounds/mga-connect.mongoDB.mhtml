require("dotenv").config();
const express =3D require("express");
const mongoose =3D require("mongoose");
const cors =3D require("cors");
const nodemailer =3D require("nodemailer");
const Booking =3D require("./BookingModel");

const app =3D express();
app.use(cors());
app.use(express.json());

const PORT =3D process.env.PORT || 5001;

// ------------------------------------------------------
//  DATABASE CONNECTION
// ------------------------------------------------------
mongoose
  .connect(process.env.MONGO_URI, {
    useNewUrlParser: true,
    useUnifiedTopology: true,
  })
  .then(() =3D&gt; console.log("=E2=9C=85 Connected to MongoDB"))
  .catch((err) =3D&gt; console.error("=E2=9D=8C MongoDB error:", err));

// ------------------------------------------------------
//  EMAIL TRANSPORTER (used everywhere)
// ------------------------------------------------------
const transporter =3D nodemailer.createTransport({
  service: "gmail",
  auth: {
    user: process.env.GMAIL_USER,
    pass: process.env.GMAIL_APP_PASSWORD,
  },
});

// Public link for cancellation (fallback for local)
const PUBLIC_BASE_URL =3D
  process.env.PUBLIC_BASE_URL || "https://mga-connect.onrender.com";

// ------------------------------------------------------
//  CREATE A NEW BOOKING
// ------------------------------------------------------
app.post("/bookings", async (req, res) =3D&gt; {
  try {
    const bookingData =3D req.body;

    // Generate Booking Code (MGA-YYYYMMDD-ID)
    const today =3D new Date();
    const dateCode =3D today
      .toISOString()
      .slice(0, 10)
      .replace(/-/g, "");
    const idCode =3D Math.floor(Math.random() * 1000);
    const bookingCode =3D <code>MGA-${dateCode}-${idCode}</code>;

    const newBooking =3D new Booking({
      ...bookingData,
      bookingCode,
    });

    await newBooking.save();

    console.log("=F0=9F=86=95 New booking created:", newBooking.bookingCode=
);
    res.json(newBooking);
  } catch (err) {
    console.error("=E2=9D=8C Error creating booking:", err);
    res.status(500).json({ message: "Error creating booking" });
  }
});

// ------------------------------------------------------
//  GET ALL BOOKINGS (for Booking Summary)
// ------------------------------------------------------
app.get("/bookings", async (req, res) =3D&gt; {
  try {
    const bookings =3D await Booking.find().sort({ createdAt: -1 });
    res.json(bookings);
  } catch (err) {
    console.error("=E2=9D=8C Error fetching bookings:", err);
    res.status(500).json({ message: "Error fetching bookings" });
  }
});
// ------------------------------------------------------
//  INVOICE SUMMARY (Group by Corporate/Bank Name)
// ------------------------------------------------------
app.get("/invoices/summary", async (req, res) =3D&gt; {
  try {
    const rows =3D await Booking.aggregate([
      {
        $addFields: {
          safePax: {
            $convert: {
              input: {
                $cond: [
                  { $in: ["$numberOfPassenger", [null, "", " "]] },
                  0,
                  "$numberOfPassenger"
                ]
              },
              to: "int",
              onError: 0,
              onNull: 0
            }
          },
          safeBill: {
            $convert: {
              input: {
                $cond: [
                  { $in: ["$billAmount", [null, "", " "]] },
                  0,
                  "$billAmount"
                ]
              },
              to: "double",
              onError: 0,
              onNull: 0
            }
          }
        }
      },
      {
        $group: {
          _id: { $ifNull: ["$corporateBankName", "Other"] },
          pax: { $sum: "$safePax" },
          billAmount: { $sum: "$safeBill" },
          totalBookings: { $sum: 1 },
          serviceTypes: { $addToSet: "$serviceType" }
        }
      },
      {
        $project: {
          _id: 0,
          corporateBankName: "$_id",
          pax: 1,
          billAmount: 1,
          totalBookings: 1,
          serviceTypes: 1,
          groupType: {
            $switch: {
              branches: [
                {
                  case: {
                    $regexMatch: {
                      input: { $toLower: "$_id" },
                      regex: "bank"
                    }
                  },
                  then: "Bank"
                },
                {
                  case: {
                    $regexMatch: {
                      input: { $toLower: "$_id" },
                      regex:
                        "talon|haque|sikdar|rahim|chevron|lanka|brac|travel=
|group|asia|akbar|ezzy|one|finance"
                    }
                  },
                  then: "Corporate"
                }
              ],
              default: "Other"
            }
          }
        }
      },
      { $sort: { corporateBankName: 1 } }
    ]);

    // Add serial number
    const withNo =3D rows.map((r, idx) =3D&gt; ({ no: idx + 1, ...r }));
    res.json(withNo);
  } catch (err) {
    console.error("=E2=9D=8C Error fetching invoice summary:", err);
    res.status(500).json({ message: "Error fetching invoice summary" });
  }
});

// ------------------------------------------------------
//  INVOICE DETAILS FOR A SPECIFIC CLIENT
// ------------------------------------------------------
app.get("/invoices/details", async (req, res) =3D&gt; {
  const { corporateBankName } =3D req.query;

  if (!corporateBankName) {
    return res
      .status(400)
      .json({ message: "corporateBankName query is required" });
  }

  try {
    const bookings =3D await Booking.find({ corporateBankName });

    if (!bookings.length) {
      return res
        .status(404)
        .json({ message: "No bookings found for this client" });
    }

    res.json(bookings);
  } catch (err) {
    console.error("=E2=9D=8C Error fetching invoice details:", err);
    res.status(500).json({ message: "Error fetching invoice details" });
  }
});
// ------------------------------------------------------
//  STAFF-WISE ANALYSIS   =E2=86=90 ADD THIS BLOCK HERE
// ------------------------------------------------------
app.get("/analysis/staff", async (req, res) =3D&gt; {
  try {
    let { staff, start, end } =3D req.query;

    if (!staff || !start || !end) {
      return res.status(400).json({ message: "Missing fields" });
    }

    // Convert date range
    const startDate =3D new Date(start);
    const endDate =3D new Date(end);
    endDate.setHours(23, 59, 59, 999);

    const results =3D await Booking.find({
      serviceBy: { $regex: new RegExp(staff, "i") }, // case-insensitive
      createdAt: { $gte: startDate, $lte: endDate },
    }).sort({ flightDate: 1 });

    res.json(results);
  } catch (err) {
    console.error("=E2=9D=8C Staff analysis error:", err);
    res.status(500).json({ message: "Error fetching staff analysis" });
  }
});
// ------------------------------------------------------
//  CATEGORY-WISE ANALYSIS
// ------------------------------------------------------
// ------------------------------------------------------
//  CATEGORY ANALYSIS
// ------------------------------------------------------
app.get("/analysis/category", async (req, res) =3D&gt; {
  try {
    const { category, start, end } =3D req.query;

    if (!category || !start || !end) {
      return res.status(400).json({
        message: "category, start, end are required",
      });
    }

    const results =3D await Booking.find({
      passengerCategory: category,
      flightDate: { $gte: start, $lte: end }
    }).sort({ flightDate: 1 });

    res.json(results);
  } catch (err) {
    console.error("=E2=9D=8C Category Analysis Error:", err);
    res.status(500).json({ message: "Error fetching category analysis" });
  }
});
// ------------------------------------------------------
//  SERVICE TYPE ANALYSIS  (Standard vs Premium, etc.)
// ------------------------------------------------------
app.get("/analysis/service-type", async (req, res) =3D&gt; {
  try {
    const { startDate, endDate } =3D req.query;

    if (!startDate || !endDate) {
      return res
        .status(400)
        .json({ message: "startDate &amp; endDate are required" });
    }

    const bookings =3D await Booking.find({
      flightDate: { $gte: startDate, $lte: endDate }
    });

    // Group by serviceType
    const summary =3D bookings.reduce((acc, b) =3D&gt; {
      const type =3D b.serviceType || "Unknown";

      if (!acc[type]) {
        acc[type] =3D { serviceType: type, totalServices: 0, totalPassenger=
s: 0 };
      }

      acc[type].totalServices +=3D 1;
      acc[type].totalPassengers +=3D Number(b.numberOfPassenger || 0);

      return acc;
    }, {});

    res.json(Object.values(summary));
