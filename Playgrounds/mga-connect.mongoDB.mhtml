onfusion I would request you to check the Category wise file once: import R=
eact, { useState } from "react";
import axios from "axios";
import * as XLSX from "xlsx";

export default function CategoryAnalysis() {
  const [startDate, setStartDate] =3D useState("");
  const [endDate, setEndDate] =3D useState("");
  const [data, setData] =3D useState([]);

  const fetchData =3D async () =3D&gt; {
    if (!startDate || !endDate) {
      alert("Please select both dates");
      return;
    }

    try {
      const res =3D await axios.get("https://mga-connect.onrender.com/analysis/categor=
y", {
        params: { startDate, endDate },
      });

      setData(res.data || []);
    } catch (err) {
      console.error("Error:", err);
      alert("Failed to load category analysis");
    }
  };

  const exportExcel =3D () =3D&gt; {
    if (data.length =3D=3D=3D 0) {
      alert("No data to export");
      return;
    }

    const ws =3D XLSX.utils.json_to_sheet(data);
    const wb =3D XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, "Category Analysis");
    XLSX.writeFile(wb, "Category_Analysis.xlsx");
  };
  const btnStyle =3D {
  padding: "8px 16px",
  backgroundColor: "#00a2ff",
  color: "white",
  border: "none",
  borderRadius: "5px",
  cursor: "pointer",
};

  return (
    &lt;div style=3D{{ maxWidth: 700, margin: "0 auto" }}&gt;
      &lt;h2 style=3D{{ textAlign: "center" }}&gt;Category-wise Analysis&lt=
;/h2&gt;

      {/* Date Filters */}
      &lt;div style=3D{{ display: "flex", gap: "10px", justifyContent: "cen=
ter" }}&gt;
        &lt;div&gt;
          &lt;label&gt;Start Date&lt;/label&gt;
          &lt;input
            type=3D"date"
            value=3D{startDate}
            onChange=3D{(e) =3D&gt; setStartDate(e.target.value)}
          /&gt;
        &lt;/div&gt;

        &lt;div&gt;
          &lt;label&gt;End Date&lt;/label&gt;
          &lt;input
            type=3D"date"
            value=3D{endDate}
            onChange=3D{(e) =3D&gt; setEndDate(e.target.value)}
          /&gt;
        &lt;/div&gt;

        &lt;button onClick=3D{fetchData} style=3D{{ height: "35px" }}&gt;
          Generate
        &lt;/button&gt;
      &lt;/div&gt;

      {/* Table */}
      &lt;table
        style=3D{{
          width: "100%",
          marginTop: 20,
          borderCollapse: "collapse",
          fontSize: "14px",
        }}
      &gt;
        &lt;thead&gt;
          &lt;tr style=3D{{ background: "#e8f4ff" }}&gt;
            &lt;th style=3D{{ border: "1px solid #ccc", padding: 8 }}&gt;Ca=
tegory&lt;/th&gt;
            &lt;th style=3D{{ border: "1px solid #ccc", padding: 8 }}&gt;To=
tal Services&lt;/th&gt;
            &lt;th style=3D{{ border: "1px solid #ccc", padding: 8 }}&gt;To=
tal Pax&lt;/th&gt;
          &lt;/tr&gt;
        &lt;/thead&gt;
        &lt;tbody&gt;
          {data.map((row, i) =3D&gt; (
            &lt;tr key=3D{i}&gt;
              &lt;td style=3D{{ border: "1px solid #ccc", padding: 8 }}&gt;
                {row.category}
              &lt;/td&gt;
              &lt;td style=3D{{ border: "1px solid #ccc", padding: 8 }}&gt;
                {row.totalServices}
              &lt;/td&gt;
              &lt;td style=3D{{ border: "1px solid #ccc", padding: 8 }}&gt;
                {row.totalPassengers}
              &lt;/td&gt;
            &lt;/tr&gt;
          ))}

          {data.length =3D=3D=3D 0 &amp;&amp; (
            &lt;tr&gt;
              &lt;td colSpan=3D{3} style=3D{{ textAlign: "center", padding:=
 10 }}&gt;
                No data found
              &lt;/td&gt;
            &lt;/tr&gt;
          )}
        &lt;/tbody&gt;
      &lt;/table&gt;

      {/* Export */}
      {data.length &gt; 0 &amp;&amp; (
        &lt;div style=3D{{ textAlign: "right", marginTop: 10 }}&gt;
          &lt;button onClick=3D{exportExcel}&gt;Export Excel&lt;/button&gt;
        &lt;/div&gt;
      )}
    &lt;/div&gt;
  );
}</div></div></div></div></div><div class=3D"z-0 flex justify-end"><div cla=
