&lt;/td&gt;&lt;td&gt;${updatedBooking.flightTime}&lt;/td&gt;&lt;/tr&gt;
              &lt;tr&gt;&lt;td&gt;&lt;strong&gt;No. of Passengers:&lt;/stro=
ng&gt;&lt;/td&gt;&lt;td&gt;${updatedBooking.numberOfPassenger}&lt;/td&gt;&l=
t;/tr&gt;
              &lt;tr&gt;&lt;td&gt;&lt;strong&gt;Service Type:&lt;/strong&gt=
;&lt;/td&gt;&lt;td&gt;${updatedBooking.serviceType}&lt;/td&gt;&lt;/tr&gt;
              &lt;tr&gt;&lt;td&gt;&lt;strong&gt;Transport:&lt;/strong&gt;&l=
t;/td&gt;&lt;td&gt;${updatedBooking.transport}&lt;/td&gt;&lt;/tr&gt;
