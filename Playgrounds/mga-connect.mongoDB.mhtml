    booking.status =3D "Notified";
    await booking.save();

    res.json({ message: "Client notified" });
  } catch (err) {
    console.error("=E2=9D=8C Notify error:", err);
    res.status(500).json({ message: "Email sending failed" });
  }
});

// ------------------------------------------------------
//  CANCEL BOOKING  (Client clicks Cancel My Booking)
// ------------------------------------------------------
app.get("/cancel", async (req, res) =3D&gt; {
  const { id, email } =3D req.query;

  if (!id || !email) {
    return res.status(400).send("Invalid cancellation link.");
  }

  try {
    const booking =3D await Booking.findOneAndUpdate(
      { bookingCode: id, email },
      { status: "Cancelled" },
      { new: true }
    );

    if (!booking) {
      return res.status(404).send("Booking not found or invalid.");
    }

    console.log(<code>=F0=9F=9A=AB Booking ${id} cancelled by client</code>=
);
