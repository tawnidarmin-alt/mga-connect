        &lt;tbody&gt;
          {filteredInvoices.map((item, i) =3D&gt; (
            &lt;tr key=3D{<code>${item.corporateBankName}-${i}</code>}&gt;
              &lt;td style=3D{{ border: "1px solid #ccc", padding: "6px" }}=
&gt;
                {item.no ?? i + 1}
              &lt;/td&gt;
              &lt;td style=3D{{ border: "1px solid #ccc", padding: "6px" }}=
&gt;
