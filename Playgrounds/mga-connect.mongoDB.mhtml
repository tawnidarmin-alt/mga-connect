      &lt;button
        onClick=3D{() =3D&gt; handleNotify(b._id)}
        style=3D{{
          marginLeft: "8px",
          padding: "4px 8px",
          backgroundColor: "#007bff",
          color: "white",
          border: "none",
          borderRadius: "4px",
          cursor: "pointer"
        }}
      &gt;
        Notify Client
      &lt;/button&gt;
      ) : b.status =3D=3D=3D "Cancelled" ? (
    &lt;span style=3D{{ color: "red", fontWeight: "600" }}&gt;Cancelled&lt;=
/span&gt;
  ) : (
    &lt;button className=3D"cancel-btn" disabled&gt;Cancel&lt;/button&gt;
    &lt;/&gt;
  )}
&lt;/td&gt;
        &lt;/tr&gt;
              ))
            ) : (
              &lt;tr&gt;
                &lt;td colSpan=3D"23" style=3D{{ textAlign: "center" }}&gt;=
No Records Found!&lt;/td&gt;
              &lt;/tr&gt;
            )}
          &lt;/tbody&gt;
        &lt;/table&gt;
      &lt;/div&gt;
    &lt;/div&gt;
  );
